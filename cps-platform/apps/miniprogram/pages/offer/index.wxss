.detail-page{padding-bottom:240rpx}.ticket{padding:34rpx;background:#e7f0e8;border:1rpx solid #dbe6dd;border-radius:28rpx}.ticket-head{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.ticket-head .tag{background:#fff;color:#527564}.ticket-label{font-size:21rpx;color:#79917e}.detail-title{font-size:43rpx;font-weight:650;color:#184e37;line-height:1.5;margin:32rpx 0 18rpx}.benefit{font-size:32rpx;color:#9e6b26;line-height:1.6}.ticket-line{height:1rpx;border-top:2rpx dashed #bacdbd;margin:32rpx -34rpx}.ticket-foot{font-size:23rpx;color:#6e8274;line-height:1.7}.steps{display:flex;flex-direction:column;gap:30rpx}.step{display:flex;gap:22rpx;align-items:flex-start}.step-number{background:#eaf2eb;color:#12654f;font-size:23rpx;width:42rpx;height:42rpx;line-height:42rpx;border-radius:50%;text-align:center;flex-shrink:0;margin-top:4rpx}.step-title{font-size:28rpx;margin-bottom:7rpx;font-weight:500}.disclosure{font-size:23rpx;color:#8a948d;line-height:1.8;margin-top:30rpx}.claim-bar{position:fixed;bottom:0;left:0;right:0;border-top:1rpx solid #e1e9e3;background:#fff;padding:20rpx 32rpx 32rpx;padding-bottom:calc(26rpx + env(safe-area-inset-bottom));z-index:10}.claim-tip{text-align:center;color:#829086;font-size:22rpx;margin-bottom:16rpx}
