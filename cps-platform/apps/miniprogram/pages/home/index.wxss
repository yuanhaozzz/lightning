.hero{background:#e8f0e8;border:1rpx solid #dfe9df;border-radius:28rpx;padding:36rpx;position:relative;overflow:hidden}.hero .title{color:#194f3a}.hero-bottom{display:flex;align-items:center;justify-content:space-between;margin-top:28rpx;font-size:23rpx;color:#617b68}.hero-stamp{width:60rpx;height:60rpx;border:2rpx solid #b0c6ac;border-radius:50%;font-size:32rpx;color:#829c7c;text-align:center;line-height:56rpx;transform:rotate(-12deg)}.search-bar{display:flex;align-items:center;gap:14rpx;background:white;border:1rpx solid #e1e8e2;border-radius:18rpx;padding:10rpx 14rpx 10rpx 22rpx;margin-top:26rpx}.search-mark{font-size:40rpx;color:#768b80}.search-bar input{flex:1;min-width:0;font-size:26rpx;height:64rpx}.search-placeholder{color:#9ba69e}.search-button{background:#12654f;color:white;font-size:24rpx;padding:14rpx 22rpx;flex-shrink:0;border-radius:12rpx}.notice{display:flex;gap:14rpx;margin-top:22rpx;color:#718078;font-size:22rpx;line-height:1.7}.notice-label{color:#12654f;flex-shrink:0;font-weight:600}.services{display:flex;flex-wrap:wrap;gap:16rpx}.service{width:calc((100% - 48rpx)/4);padding:24rpx 4rpx 20rpx;background:#fff;border:1rpx solid #e5ece7;font-size:23rpx;color:#496454;border-radius:20rpx}.service-icon{width:60rpx;height:60rpx;line-height:60rpx;background:#edf2e9;color:#577154;border-radius:18rpx;margin:0 auto 12rpx;font-size:29rpx;font-weight:600}.service-active{border-color:#80aa92;background:#edf5ef}.filters{white-space:nowrap;margin:0 0 26rpx;width:100%}.filter{display:inline-block;font-size:24rpx;color:#708178;padding:13rpx 25rpx;border-radius:100rpx;margin-right:14rpx;background:#eaf0eb}.filter-active{background:#12654f;color:#fff}.offer-list{display:flex;flex-direction:column;gap:20rpx}.offer-card{text-align:left;padding:28rpx 30rpx;background:#fff;border:1rpx solid #e4eae5;border-radius:24rpx;width:100%;color:#254d3a}.offer-top{display:flex;justify-content:space-between;align-items:center}.demo-tag{font-size:21rpx;color:#a37d33}.offer-title{font-size:31rpx;font-weight:650;margin-top:22rpx;line-height:1.5}.offer-benefit{font-size:27rpx;color:#b27635;margin-top:10rpx;line-height:1.6}.offer-bottom{display:flex;align-items:center;justify-content:space-between;border-top:1rpx dashed #e4eae5;margin-top:24rpx;padding-top:20rpx;font-size:23rpx;color:#839087}.card-arrow{font-size:32rpx;color:#12654f;line-height:1}
