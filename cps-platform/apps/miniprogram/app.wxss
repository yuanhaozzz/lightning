page{background:#f6f8f5;color:#213e33;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx;line-height:1.6}
view,text,button,input{box-sizing:border-box}
button::after{border:0}
button{margin:0;font:inherit;line-height:1.5;border-radius:18rpx}
.page{padding:32rpx 32rpx 56rpx}
.eyebrow{font-size:21rpx;letter-spacing:4rpx;color:#6c8177;font-weight:600}
.title{font-size:48rpx;line-height:1.3;font-weight:700;letter-spacing:-1rpx;margin:14rpx 0}
.subtitle{font-size:26rpx;color:#718078;line-height:1.8}
.section-heading{display:flex;justify-content:space-between;align-items:center;margin:38rpx 0 22rpx}
.section-title{font-size:32rpx;font-weight:650}
.small{font-size:23rpx;color:#7c8781}
.panel{background:#fff;border:1rpx solid #e5ece7;border-radius:24rpx;padding:30rpx}
.primary{background:#12654f;color:#fff;padding:26rpx 28rpx;font-weight:600;text-align:center}
.primary[disabled]{background:#c8d6cf;color:#f8faf9}
.secondary{background:#edf3ef;color:#12654f;padding:22rpx 28rpx;font-weight:600}
.text-button{background:transparent;color:#12654f;padding:10rpx 0;font-size:25rpx}
.state{padding:72rpx 28rpx;text-align:center;background:#fff;border:1rpx solid #e4ebe6;border-radius:24rpx}
.state-title{font-size:30rpx;font-weight:600;margin-bottom:12rpx}
.state-copy{font-size:25rpx;color:#74837b;line-height:1.8;margin-bottom:26rpx}
.muted{color:#74837b}
.tag{font-size:21rpx;background:#edf4ef;color:#547465;border-radius:8rpx;padding:4rpx 12rpx;display:inline-block}
.divider{height:1rpx;background:#edf1ee;margin:28rpx 0}
.body-copy{white-space:pre-wrap;font-size:27rpx;line-height:1.9;color:#53665c;word-break:break-all}
.footer-note{text-align:center;margin:40rpx 0 12rpx;font-size:22rpx;color:#88948d}
