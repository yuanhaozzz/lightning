# Copy to .env.local. Never commit real passwords, cookies or upstream credentials.
NODE_ENV=development
HOST=127.0.0.1
PORT=3018
DATABASE_PATH=./data/cps.sqlite
DEMO_MODE=true
SITE_NAME=青岛省心券
ADMIN_USERNAME=admin
# Required: replace with your own password (at least 12 characters).
ADMIN_PASSWORD=
# HTTPS public origin is required in production, no trailing slash.
PUBLIC_ORIGIN=
SUPPORT_WECHAT=
# Reserved for a later verified provider adapter. Setting these DOES NOT enable API calls.
MEITUAN_APP_KEY=
MEITUAN_APP_SECRET=
